<div id="editModal" class="modal hidden fade" aria-labelledby="editModal"
  aria-hidden="true">
   <div class="modal-dialog" role="document">
      <div class="modal-content">
         <form id="editForm" action="editList/" method="post">
            <div class="modal-header">
               <h5 class="modal-title" id="modalTitle"></h5>
               <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="modal-body">
               <input type="text" id="nameInput" autocomplete="off" class="form-control" name="listName" placeholder="List Name" required>
               <div class="ml-5 mt-4 mb-0" id="editColors">
                  {{#each colors}}
                  {{>colorButton}}
                  {{/each}}
               </div>
            </div>
            <div class="modal-footer" name="color">
               <button id="editGoButton" type="submit" value="Submit" class="btn btn-dark blue-gradient px-3 py-2 z-depth-0">Go!</button>
            </div>
         </form>
      </div>
   </div>
</div>
