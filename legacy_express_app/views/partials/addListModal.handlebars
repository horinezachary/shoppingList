<div id="addListModal" class="modal hidden fade" aria-labelledby="addListModal"
  aria-hidden="true">
   <div class="modal-dialog" role="document">
      <div class="modal-content">
         <form action="addList/" method="post">
            <div class="modal-header">
               <h5 class="modal-title" id="modalTitle">New List</h5>
               <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="modal-body">
               <input type="text" autocomplete="off" class="form-control" name="listName" placeholder="List Name" autofocus required>
               <div class="radio-buttons ml-5 mt-4 mb-0">
                 {{#each colors}}
                 {{>colorButton}}
                 {{/each}}
               </div>
            </div>
            <div class="modal-footer" name="color">
               <button type="submit" value="Submit" class="btn btn-dark blue-gradient px-3 py-2 z-depth-0">Go!</button>
            </div>
         </form>
      </div>
   </div>
</div>
