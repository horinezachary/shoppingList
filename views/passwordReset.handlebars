<div class="card list" style="width: 30rem;">
	<div class="card-header">
		<h3>Update Password</h3>
	</div>
	<div class="card-body">
      {{#if error}}
         <div class="pb-1 pt-1 alert-danger alert text-center" role="alert">{{error}}</div>
      {{/if}}
		<form action="/updatePassword/{{token}}" method="POST">
			<div class="input-group form-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="fas fa-key"></i></span>
				</div>
				<input type="password" class="form-control" name="password" placeholder="new password (at least 8 characters)" minlength="8" autocomplete="new-password" autofocus required>
			</div>
         <div class="input-group form-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="fas fa-key"></i></span>
				</div>
				<input type="password" class="form-control" name="password2" placeholder="password again" autofocus required>
			</div>
			<div class="form-group float-right">
				<input type="submit" value="Update" class="btn btn-dark float-right login_btn">
			</div>
		</form>
	</div>
</div>
