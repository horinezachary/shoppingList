<div class="card list" style="width: 30rem;">
	<div class="card-header">
		<h3>Share Confirmation</h3>
	</div>
	<div class="card-body">
      <p>You have successfully accepted <b>{{share_perms}}</b> permissions from <b>{{share_list.owner}}</b> for the list <b>{{share_list.list_name}}</b>.</p>
			<p> Press the button below to go to the shared list.</p>
      <div class="row">
        <div class="btn-group"  style="margin: 0 auto; float: none;">
          <a class="btn" style="background: #{{share_list.listColor}}" href="/l/{{share_list.list_id}}">{{share_list.list_name}}</a>
        </div>
      </div>
	</div>
</div>
