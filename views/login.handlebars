<div class="card list" style="width: 20rem;">
	<div class="card-header">
		<h3>Sign In</h3>
	</div>
	<div class="card-body">
      {{#if notice}}
         <div class="pb-1 pt-1 alert-success alert text-center" role="status">{{notice}}</div>
      {{/if}}
      {{#if error}}
         <div class="pb-1 pt-1 alert-danger alert text-center" role="alert">{{error}}</div>
      {{/if}}
		<form action="/login" method="POST">
			<div class="input-group form-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="fas fa-user"></i></span>
				</div>
				<input type="text" class="form-control" name="username" placeholder="username" autofocus required>

			</div>
			<div class="input-group form-group">
				<div class="input-group-prepend">
					<span class="input-group-text"><i class="fas fa-key"></i></span>
				</div>
				<input type="password" class="form-control" name="password" placeholder="password" autofocus required>
			</div>
			<div class="row align-items-center remember ml-2">
				<p class="mb-0"><input name="remember" type="checkbox"> Remember Me</p>
			</div>
			<div class="form-group float-right">
				<input type="submit" value="Login" class="btn btn-dark float-right login_btn">
			</div>
		</form>
	</div>
	<div class="card-footer">
		<div class="d-flex justify-content-center links">
			<p class="mb-0">Don't have an account? <a style="color:blue;" href="/register">Sign Up!</a></p>
		</div>
		<div class="d-flex justify-content-center">
			<a style="color:blue;" data-toggle="modal" data-target="#passwordResetModal">Forgot your password?</a>
		</div>
	</div>
</div>
{{>passwordResetModal}}
