            <a class="navbar-brand" href="/">Lori's List</a>

            {{#if loginButton}}
               <ul class="navbar-nav ml-auto nav-flex-icons" style="float: right;">
                  <li class="nav-item">
                    <a class="btn btn-dark nav-link lh-0" href="/login">Login</a>
