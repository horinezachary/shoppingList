<div class="card list" id="list_{{listItem.0.list_id}}" style="width: 30rem; background:#{{listItem.0.listColor}};">
   <div class="card-body listHeader">
      <h3 class="font-weight-bold mb-3 list-name">{{listItem.0.list_name}}</h3>
      <!--<h4 class="mb-0 list-owner"> - <a href="/u/{{listItem.0.owner}}">{{listItem.0.owner}}</a></h4>-->
      <!--<h5 class="list-date">{{listItem.0.date_created}}</h5>-->
      <button type="button" class="btn btn-sm btn-outline-dark list-clearButton" onClick=clearCheckedItems('list-group_{{listItem.0.list_id}}')>Clear</button>
   </div>
   <ul class="list-group list-group-flush" id="list-group_{{listItem.0.list_id}}">
      {{#each listItem}}
         {{> listLine}}
      {{/each}}
      <li class="list-group-item listItem" id="listItem-add_{{listItem.0.list_id}}" style="background:#{{listItem.0.listColor}};">
         <form action="addItem/{{listItem.0.list_id}}" method="post">
            <div class="form-row">
               <div class="col-2">
                  <input type="number" class="form-control" name="icount" placeholder="#">
               </div>
               <div class="input-group col-10">
                  <input type="text" list="autofill" autocomplete="off" class="form-control" name="itemName" placeholder="Item" required>
                  <datalist id="autofill">
                     {{#each autofillItem}}
                        <option>{{item_name}}</option>
                     {{/each}}
                  </datalist>
                  <div class="input-group-append">
                     <button type="submit" value="Submit" class="btn btn-md btn-outline-black m-0 px-3 py-2 z-depth-0" style="line-height:0;"><p class="fas fa-arrow-right m-0"></button>
                  </div>
               </div>
            </div>
         </form>
      </li>
   </ul>
</div>
