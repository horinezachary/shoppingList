{{#if showAlert}}
   <div class="list alert alert-primary" style="width: 95%; max-width: 50rem; margin-bottom: 1rem;" role="alert">
      <ul style="margin-bottom:0rem; padding-left:0rem; list-style-type:none;">
         <li>Welcome to your list! Here you can add things to your list using the text box below.</li>
         <li>You can click or tap on an item to cross it off.</li>
         <li>When you are done, you can click the clear button to remove the crossed off items from your list.</li>
      </ul>
      <hr>
      <div>
         <form  style="display:inline-block" action="showAlert/{{list.0.list_id}}" method="post">
            <button type="submit" name="dontshow" value="Show" class="close" style="margin:0;"><p style="margin:0;">Don't show this again</p></button>
         </form>
            <button style="display:inline-block" type="button" class="close fr" data-dismiss="alert" aria-label="Close">
               <span aria-hidden="true">Close</span>
            </button>
      </div>
   </div>
{{/if}}

<div class="card list" id="list_{{list.0.list_id}}" style="width: 95%; max-width: 30rem; background:#{{list.0.listColor}};">
   <div class="card-body listHeader">
      <h3 class="font-weight-bold mb-3 list-name">{{list.0.list_name}}</h3>
      <!--<h4 class="mb-0 list-owner"> - <a href="/u/{{listItem.0.owner}}">{{listItem.0.owner}}</a></h4>-->
      <!--<h5 class="list-date">{{listItem.0.date_created}}</h5>-->
      <button type="button" id="clearButton" class="btn btn-sm btn-outline-dark list-clearButton {{#if buttonDisabled}}disabled{{/if}}" onClick=deleteItems('{{listItem.0.list_id}}','list-group_{{listItem.0.list_id}}')>Clear</button>
   </div>
   <ul class="list-group list-group-flush" id="list-group_{{list.0.list_id}}">
      {{#each listItem}}
         {{> listLine}}
      {{/each}}
      <li class="list-group-item listItem" id="listItem-add_{{list.0.list_id}}" style="background:#{{list.0.listColor}};">
         <form action="addItem/{{list.0.list_id}}" method="post">
            <div class="form-row">
               <div class="col-2">
                  <input type="number" class="form-control" name="icount" placeholder="#" min="0">
               </div>
               <div class="input-group col-10">
                  <input type="text" list="autofill" autocomplete="off" class="form-control" name="itemName" placeholder="Item" required>
                  <datalist id="autofill">
                     {{#each autofillItem}}
                        <option>{{item_name}}</option>
                     {{/each}}
                  </datalist>
                  <div class="input-group-append">
                     <button type="submit" value="Submit" class="btn btn-md btn-outline-black m-0 px-3 py-2 z-depth-0" style="line-height:0;"><p class="fas fa-arrow-right m-0"></button>
                  </div>
               </div>
            </div>
         </form>
      </li>
   </ul>
</div>
