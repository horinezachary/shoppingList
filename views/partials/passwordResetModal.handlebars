<div id="passwordResetModal" class="modal hidden fade" aria-labelledby="passwordResetModal"
  aria-hidden="true">
   <div class="modal-dialog" role="document">
      <div class="modal-content" style="width:30rem;">
         <form action="/passwordReset" method="post">
            <div class="modal-header">
               <h5 class="modal-title" id="modalTitle">Reset Password</h5>
               <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="modal-body">
               <p>Enter your e-mail address and we'll send you a link to reset your password.</p>
               <input type="email" class="form-control" name="email" placeholder="email address" autofocus required>
            </div>
            <div class="modal-footer">
               <button type="submit" value="Submit" class="btn btn-dark blue-gradient px-3 py-2 z-depth-0">Send</button>
            </div>
         </form>
      </div>
   </div>
</div>
