<div class="list" id="list_{{list.0.list_id}}">
   <div class="listHeader">
      <h3 class="list-name">{{list.0.list_name}}</h3>
      <h4 class="list-owner"> - <a href="/u/{{list.0.owner}}">{{list.0.owner}}</a></h4>
      <!--<h5 class="list-date">{{listItem.0.date_created}}</h5>-->
      <button class="list-clearButton" onClick=clearCheckedItems('list_{{list.0.list_id}}')>Clear</button>
   </div>
   {{#each list}}
      {{> listLine}}
   {{/each}}
</div>
