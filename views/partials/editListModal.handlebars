<div id="editModal" class="modal hidden fade" aria-labelledby="editModal"
  aria-hidden="true">
   <div class="modal-dialog" role="document">
      <div class="modal-content">
         <form id="editForm" action="editList/" method="post">
            <div class="modal-header">
               <h5 class="modal-title" id="modalTitle"></h5>
               <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
              </button>
            </div>
            <div class="modal-body">
               <input type="text" id="nameInput" autocomplete="off" class="form-control" name="listName" placeholder="List Name" required>
               <div class="ml-5 mt-4 mb-0" id="editColors">
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="e04331" checked="checked">
                    <span id="color1" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="c75f0a">
                    <span id="color2" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="d69620">
                    <span id="color3" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="12ad0c">
                    <span id="color4" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="4287f5">
                    <span id="color5" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="ad42f5">
                    <span id="color6" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="0026FF">
                    <span id="color7" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="FFD800">
                    <span id="color8" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="2DFF38">
                    <span id="color9" class="checkmark"></span>
                  </label>
                  <label class="container">
                    <input class="editRadio" type="radio" name="color" value="FB21FF">
                    <span id="color10" class="checkmark"></span>
                  </label>
               </div>
            </div>
            <div class="modal-footer" name="color">
               <button id="editGoButton" type="submit" value="Submit" class="btn btn-dark blue-gradient px-3 py-2 z-depth-0">Go!</button>
            </div>
         </form>
      </div>
   </div>
</div>
