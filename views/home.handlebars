<div class="card list" id="listHolder" style="width: 95%; max-width: 40rem;">
   <div class="card-body listHeader">
      <h3 class="font-weight-bold mb-0 user-name">My Lists</h3>
   </div>
   <ul class="list-group list-group-flush" id="list-group">
      {{#each headerlists}}
         {{>userList}}
      {{/each}}
      <li class="list-group-item" id="list_add">
         <button type="button" class="btn btn-dark ml-2 float-right" data-toggle="modal" data-target="#addListModal">New List</button>
      </li>
   </ul>
   {{>deleteModal}}
   {{>editListModal}}
</div>

{{#if sharedlists}}
<div class="card list" id="sharedlistHolder" style="width: 95%; max-width: 40rem; margin-top: 10px;">
   <div class="card-body listHeader">
      <h3 class="font-weight-bold mb-0 user-name">Shared Lists</h3>
   </div>
   <ul class="list-group list-group-flush" id="list-group">
      {{#each sharedlists}}
         {{>sharedList}}
      {{/each}}
      <li class="list-group-item" id="list_add"></li>
   </ul>
   {{>unsubModal}}
</div>
{{/if}}
